{
  "buildCommand": "cd src && npm install && npm run build",
  "outputDirectory": "src/dist",
  "framework": "vite",
  "regions": ["syd1"],
  "functions": {
    "api/focus-chat.ts": {
      "includeFiles": "docs/user-manual/**"
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
